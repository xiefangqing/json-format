{
  "name": "@xiefangqing/json-format",
  "version": "0.1.0",
  "description": "Browser-only JSON formatter and tree viewer",
  "type": "module",
  "bin": {
    "json-format": "bin/cli.mjs"
  },
  "files": [
    "bin/cli.mjs",
    "src/frontend/dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "pnpm --dir src/frontend run dev",
    "build": "pnpm --dir src/frontend run build",
    "build:site": "pnpm build && node scripts/sync-site.mjs",
    "preview": "pnpm --dir src/frontend run preview",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@8.15.9",
  "dependencies": {
    "open": "^11.0.4",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.5.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
